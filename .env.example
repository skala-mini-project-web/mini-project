# Local Docker Compose defaults. Copy to .env only when overriding values.
DB_NAME=crosschecklab
DB_USERNAME=crosschecklab
DB_PASSWORD=crosschecklab
DB_PORT=5432
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# Synthetic credential shared by the local-demo backend and AI service. Do not reuse.
AI_SERVICE_INTERNAL_TOKEN=crosschecklab-local-internal-token

# Compose containers reach the host Ollama through this URL.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Ollama request context size and model keep-alive. Lower NUM_CTX (e.g. 8192) or set KEEP_ALIVE=1m on a shared machine.
OLLAMA_NUM_CTX=32768
OLLAMA_KEEP_ALIVE=

# Container memory ceilings for the local demo. Raise BACKEND_MEM_LIMIT before 100-file batch runs on a large corpus.
BACKEND_MEM_LIMIT=2g
BACKEND_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0 -XX:+ExitOnOutOfMemoryError
AI_SERVICE_MEM_LIMIT=512m

# Default 5m total budget for one document extraction (not a per-page guarantee).
# Must be greater than OCR_WORKER_REQUEST_TIMEOUT and at most 9m30s for the 10m lease.
OCR_WORKER_REQUEST_TIMEOUT=45s
DOCUMENT_BATCH_EXTRACTION_TIMEOUT=5m
