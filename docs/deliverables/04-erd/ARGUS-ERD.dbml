  Indexes {
    (rag_run_id, evidence_document_chunk_id) [unique, name: 'ux_analysis_rag_snapshots_chunk']
    (rag_run_id, rank) [unique, name: 'ux_analysis_rag_snapshots_rank']
    evidence_document_id [name: 'idx_analysis_rag_snapshots_document']
