Table users {
  id bigint [pk, increment]
  username varchar(50) [not null]
  name varchar(100) [not null]
  role varchar(30) [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    username [unique, name: 'users_username_key']
  }
}

Table products {
  id bigint [pk, increment]
  owner_id bigint [not null]
  name varchar(100) [not null]
  product_type varchar(20) [not null]
  description varchar(500)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (id, owner_id) [unique, name: 'ux_products_id_owner']
    owner_id [name: 'idx_products_owner']
  }
}

Table product_documents {
  id bigint [pk, increment]
  product_id bigint [not null]
  file_name varchar(255) [not null]
  media_type varchar(150) [not null]
  file_size bigint
  checksum varchar(64)
  storage_key varchar(500) [not null]
  extract_status varchar(20) [not null, default: 'UPLOADED']
  extracted_text text
  confirmed boolean [not null, default: false]
  confirmed_by bigint
  confirmed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  extraction_error_code varchar(60)
  extraction_error_message varchar(500)
  extraction_error_retryable boolean [not null, default: false]
  current_extraction_run_id bigint
  extracted_text_hash varchar(64)
  confirmed_extraction_run_id bigint
  confirmed_text_hash varchar(64)

  Indexes {
    (id, product_id) [unique, name: 'ux_product_documents_id_product']
    product_id [name: 'idx_product_documents_product']
  }
}

Table document_source_revisions {
  id bigint [pk, increment]
  product_document_id bigint [not null]
  revision_number integer [not null]
  file_name varchar(255) [not null]
  media_type varchar(150) [not null]
  file_size bigint [not null]
  checksum varchar(64) [not null]
  storage_key varchar(500) [not null]
  source_hash varchar(64) [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (id, product_document_id, source_hash) [unique, name: 'ux_document_source_revisions_anchor_identity']
    (product_document_id, revision_number) [unique, name: 'ux_document_source_revisions_document_revision']
    source_hash [name: 'idx_document_source_revisions_source_hash']
  }
}

Table document_extraction_runs {
  id bigint [pk, increment]
  product_document_id bigint [not null]
  run_generation integer [not null]
  source_hash varchar(64) [not null]
  config_version varchar(100) [not null]
  config_snapshot jsonb [not null]
  state varchar(20) [not null]
  result_text_hash varchar(64)
  page_count integer [not null]
  error_code varchar(60)
  error_message varchar(500)
  error_retryable boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (product_document_id, run_generation) [unique, name: 'ux_document_extraction_runs_document_generation']
    (id, product_document_id) [unique, name: 'ux_document_extraction_runs_id_document']
    (product_document_id, created_at) [name: 'idx_document_extraction_runs_document_created', note: 'created_at DESC']
    source_hash [name: 'idx_document_extraction_runs_source_hash']
  }
}

Table document_extraction_pages {
  id bigint [pk, increment]
  extraction_run_id bigint [not null]
  page_number integer [not null]
  selected_method varchar(30) [not null]
  selected_text text [not null]
  selected_text_hash varchar(64) [not null]
  pdfbox_candidate_hash varchar(64) [not null]
  ocr_render_artifact_key varchar(500)
  ocr_render_artifact_hash varchar(64)
  ocr_config_snapshot jsonb
  ocr_engine varchar(100)
  ocr_model_version varchar(150)
  ocr_language varchar(50)
  ocr_confidence numeric(7,4)
  ocr_warnings jsonb
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (extraction_run_id, page_number) [unique, name: 'ux_document_extraction_pages_run_page']
  }
}

Table ground_truth_facts {
  id bigint [pk, increment]
  document_id bigint [not null]
  label varchar(255) [not null]
  value text [not null]
  importance varchar(10) [not null]
  verification_status varchar(20) [not null]
  extraction_source varchar(30) [not null]
  source_text_sha256 varchar(64) [not null]
  created_by bigint [not null]
  decided_by bigint
  decided_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    document_id [unique, name: 'ux_ground_truth_facts_document']
  }
}

Table document_batches {
  id bigint [pk, increment]
  product_id bigint [not null]
  owner_id bigint [not null]
  scenario varchar(60) [not null]
  requested_item_count integer [not null]
  idempotency_key varchar(200) [not null]
  manifest_hash varchar(64) [not null]
  status varchar(20) [not null, default: 'PENDING']
  cancel_requested_at timestamptz
  cancellation_reason varchar(500)
  cancelled_at timestamptz
  quarantine_reason varchar(500)
  quarantined_at timestamptz
  terminal_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (id, product_id, owner_id) [unique, name: 'ux_document_batches_id_product_owner']
    (owner_id, idempotency_key) [unique, name: 'ux_document_batches_owner_idempotency_key']
    (owner_id, status) [name: 'idx_document_batches_owner_status']
    (product_id, created_at) [name: 'idx_document_batches_product_created', note: 'created_at DESC']
  }
}

Table document_batch_items {
  id bigint [pk, increment]
  batch_id bigint [not null]
  product_id bigint [not null]
  owner_id bigint [not null]
  product_document_id bigint [not null]
  ordinal integer [not null]
  source_file_name varchar(255) [not null]
  source_media_type varchar(150) [not null]
  source_file_size bigint [not null]
  source_checksum varchar(64) [not null]
  source_storage_key varchar(500) [not null]
  due_at timestamptz [not null]
  attempt_count integer [not null, default: 0]
  max_attempts integer [not null, default: 3]
  status varchar(20) [not null, default: 'PENDING']
  lease_owner varchar(100)
  lease_until timestamptz
  lease_fence bigint [not null, default: 0]
  cancel_requested_at timestamptz
  cancellation_reason varchar(500)
  cancelled_at timestamptz
  last_error_code varchar(60)
  last_error_message varchar(1000)
  quarantine_reason varchar(500)
  quarantined_at timestamptz
  terminal_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (batch_id, product_document_id) [unique, name: 'ux_document_batch_items_batch_document']
    (batch_id, ordinal) [unique, name: 'ux_document_batch_items_batch_ordinal']
    (batch_id, status, ordinal) [name: 'idx_document_batch_items_batch_status']
    (due_at, id) [name: 'idx_document_batch_items_due_claim', note: 'where status = ANY ARRAY["PENDING", "RETRY_WAIT"]']
    (lease_until, id) [name: 'idx_document_batch_items_expired_lease', note: 'where status = "LEASED"']
    (owner_id, status) [name: 'idx_document_batch_items_owner_status']
  }
}

Table document_batch_item_attempts {
  id bigint [pk, increment]
  item_id bigint [not null]
  attempt_no integer [not null]
  lease_fence bigint [not null]
  worker_owner varchar(100) [not null]
  started_at timestamptz [not null]
  ended_at timestamptz
  outcome varchar(30)
  public_error_code varchar(60)
  public_error_message varchar(1000)
  diagnostic_reference varchar(255)

  Indexes {
    (item_id, attempt_no) [unique, name: 'ux_document_batch_item_attempts_item_attempt']
    (item_id, attempt_no) [name: 'idx_document_batch_item_attempts_item']
  }
}

