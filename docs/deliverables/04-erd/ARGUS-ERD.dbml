  Indexes {
    (id, analysis_execution_id) [unique, name: 'ux_findings_id_execution']
    analysis_id [name: 'idx_findings_analysis']
    (analysis_execution_id, id) [name: 'idx_findings_execution']
    (lineage_id, revision_number) [unique, name: 'ux_findings_lineage_revision', note: 'where lineage_id IS NOT NULL']
    supersedes_finding_id [unique, name: 'ux_findings_superseded_once', note: 'where supersedes_finding_id IS NOT NULL']
  }
}

