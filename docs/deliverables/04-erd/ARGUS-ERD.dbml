}

Table evidence_document_chunks {
  id bigint [pk, increment]
  evidence_document_id bigint [not null]
  source_hash varchar(64) [not null]
  chunk_ordinal integer [not null]
  chunking_version varchar(100) [not null]
  chunk_hash varchar(64) [not null]
  chunk_text text [not null]
  embedding_model varchar(255) [not null]
  embedding vector(1024) [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (id, evidence_document_id, source_hash) [unique, name: 'ux_evidence_document_chunks_anchor_identity']
    (id, evidence_document_id) [unique, name: 'ux_evidence_document_chunks_id_document']
    (evidence_document_id, source_hash, chunking_version, embedding_model, chunk_ordinal) [unique, name: 'ux_evidence_document_chunks_identity']
    evidence_document_id [name: 'idx_evidence_document_chunks_document']
    embedding [name: 'idx_evidence_document_chunks_embedding_cosine', note: 'hnsw embedding vector_cosine_ops']
    source_hash [name: 'idx_evidence_document_chunks_source_hash']
  }
}

Table analyses {
  id bigint [pk, increment]
  product_document_id bigint [not null]
  red_team_pack_id bigint [not null]
  status varchar(20) [not null, default: 'CREATED']
  progress integer [not null, default: 0]
  risk_score integer
  model_version varchar(50)
  prompt_version varchar(50)
  requires_human_approval boolean [not null, default: true]
  retryable boolean [not null, default: false]
  error_code varchar(60)
  completed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  input_hash varchar(64) [not null]
  execution_token varchar(36) [not null, default: 'not-started']
  current_successful_execution_id bigint

  Indexes {
    product_document_id [name: 'idx_analyses_document']
    status [name: 'idx_analyses_status']
    (product_document_id, input_hash) [unique, name: 'ux_analyses_document_input_hash', note: 'where status <> "FAILED"']
  }
}

Table analysis_personas {
