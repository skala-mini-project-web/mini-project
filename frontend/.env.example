# Copy to .env. Never commit the real .env.

# Mock mode: true = run standalone with the in-memory mock API (no backend).
# false = call the real Spring backend through the /api proxy.
VITE_USE_MOCK=true

# Real backend base URL (used by the Vite dev proxy when VITE_USE_MOCK=false).
VITE_API_BASE=http://localhost:8080
